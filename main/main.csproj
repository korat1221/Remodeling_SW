<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1722.45" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.117" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="contentslist\List_Zone.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="contentslist\List_Floor.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="contentslist\List_ConstructionWall.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="contents\3D\Model.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="contents\3D\sub3dWallInfo.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="contents\3D\sub3dWinInfo.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="contents\3D\sub3dBridgeInfo.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="contents\Construction\ConstructionWall.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="subcontents\ConstructionCW\CW_ImportSize.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="subcontents\ConstructionWall\Wall_TB.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="subcontents\MaterialDB.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>